#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

BOOT_JDK_PATH = /usr/lib/jvm/java-26-coffeelibs
JDK_VERSION = 27.0.1.0.3+1

%:
	dh $@

override_dh_auto_clean:
	if [ -d build ]; then make dist-clean; rm -r build; fi

override_dh_auto_configure:
	bash configure \
	--with-conf-name=coffeelibs-openjdk-27 \
	--with-boot-jdk=$(BOOT_JDK_PATH) \
	--with-version-pre= \
	--with-version-string=$(JDK_VERSION) \
	--with-version-opt=coffeelibs \
	--with-native-debug-symbols=none \
	--with-source-date=current

override_dh_auto_build:
	make jdk-image

override_dh_auto_test:
	build/coffeelibs-openjdk-27/images/jdk/bin/java -version

override_dh_auto_install:
	# see coffeelibs-jdk-27.install

override_dh_strip_nondeterminism:
	# no-op
