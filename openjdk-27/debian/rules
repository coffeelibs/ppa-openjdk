#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

BOOT_JDK_PATH = /usr/lib/jvm/java-26-coffeelibs
JDK_VERSION = 27.0.1.0.3+1
VENDOR_URL = https://github.com/coffeelibs/ppa-openjdk
VENDOR_BUG_URL = https://github.com/coffeelibs/ppa-openjdk/issues

# configure ignores CFLAGS from dpkg-buildflags, so pass the stronger stack protector explicitly (appended after the JDK's own -fstack-protector)
HARDENING_FLAGS = -fstack-protector-strong

# PAC/BTI is only available on aarch64; configure fails if requested on other architectures
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),arm64)
ARCH_CONFIGURE_FLAGS = --enable-branch-protection
endif

%:
	dh $@

override_dh_auto_clean:
	if [ -d build ]; then make dist-clean; rm -r build; fi

# no --with-source-date: configure falls back to SOURCE_DATE_EPOCH, which dpkg-buildpackage derives from debian/changelog
override_dh_auto_configure:
	bash configure \
	--with-conf-name=coffeelibs-openjdk-27 \
	--with-boot-jdk=$(BOOT_JDK_PATH) \
	--with-version-pre= \
	--with-version-string=$(JDK_VERSION) \
	--with-version-opt=coffeelibs \
	--with-native-debug-symbols=none \
	--with-vendor-name=coffeelibs \
	--with-vendor-url=$(VENDOR_URL) \
	--with-vendor-bug-url=$(VENDOR_BUG_URL) \
	--with-vendor-vm-bug-url=$(VENDOR_BUG_URL) \
	--with-extra-cflags="$(HARDENING_FLAGS)" \
	--with-extra-cxxflags="$(HARDENING_FLAGS)" \
	$(ARCH_CONFIGURE_FLAGS)

override_dh_auto_build:
	make jdk-image

override_dh_auto_test:
	build/coffeelibs-openjdk-27/images/jdk/bin/java -version

override_dh_auto_install:
	# see coffeelibs-jdk-27.install

override_dh_strip_nondeterminism:
	# no-op
